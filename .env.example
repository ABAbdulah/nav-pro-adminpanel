# Copy to .env.local for development. On Vercel, set these in the project's
# environment variables. None of them is ever sent to the browser.

# The store API (nav-pro-listing/api). Production:
# https://nav-pro-listing-production.up.railway.app
ADMIN_API_URL=http://localhost:4000
# Must equal ADMIN_TOKEN on the API. Grants cost prices and every order: keep it
# here, server side, and nowhere else.
ADMIN_TOKEN=

# Who may sign in: comma-separated emails, and the shared password they use.
# Every change made in the panel is recorded against the email used to sign in.
ADMIN_EMAILS=owner@example.com
ADMIN_PASSWORD=

# Long random value (32+ characters) that signs the sign-in cookie. Changing it
# signs everyone out.
SESSION_SECRET=

# The storefront, for "view on the store" links. Optional.
STOREFRONT_URL=https://partsstore.vercel.app
